# Pin a reviewed otel/opentelemetry-collector-contrib image by digest.
OTEL_COLLECTOR_IMAGE=

CODESTRA_ENVIRONMENT=production
CODESTRA_REGION=hetzner-eu
CODESTRA_SERVER=codestra-core-01
CODESTRA_TELEMETRY_NETWORK=codestra-telemetry
CODESTRA_OBSERVABILITY_NETWORK=codestra-observability

TEMPO_OTLP_GRPC_ENDPOINT=tempo:4317
TEMPO_OTLP_INSECURE=true
LOKI_OTLP_HTTP_ENDPOINT=http://loki:3100/otlp
LOKI_OTLP_INSECURE=true

OTEL_COLLECTOR_MEMORY_LIMIT=1g
OTEL_COLLECTOR_CPU_LIMIT=2.0
OTEL_COLLECTOR_GOMEMLIMIT=768MiB
