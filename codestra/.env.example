# One Collector instance is assigned to one approved Codestra business.
CODESTRA_BUSINESS=platform
CODESTRA_ENVIRONMENT=staging
CODESTRA_REGION=hetzner-eu
CODESTRA_SERVER=replace-with-canonical-server-name

# Every builder, upstream and final image must be a reviewed digest reference.
GO_BUILDER_IMAGE=golang:REPLACE_WITH_PINNED_VERSION@sha256:REPLACE_WITH_64_HEX_DIGEST
OTELCOL_BASE_IMAGE=otel/opentelemetry-collector-contrib:0.159.0@sha256:REPLACE_WITH_64_HEX_DIGEST
CODESTRA_OTELCOL_IMAGE=ghcr.io/appolon1908-hue/codestra-telemetry:REPLACE_WITH_RELEASE@sha256:REPLACE_WITH_64_HEX_DIGEST

# Business-scoped ingress and private backend networks.
CODESTRA_BUSINESS_TELEMETRY_NETWORK=codestra-telemetry-platform
CODESTRA_OBSERVABILITY_NETWORK=codestra-observability

# TLS backend endpoints. Insecure exporter modes are intentionally absent.
TEMPO_OTLP_GRPC_ENDPOINT=tempo:4317
LOKI_OTLP_HTTP_ENDPOINT=https://loki:3100/otlp

# External runtime secret-object names only. Secret values never belong here.
OTELCOL_SERVER_CERT_SECRET_NAME=otelcol-server-cert
OTELCOL_SERVER_KEY_SECRET_NAME=otelcol-server-key
OTELCOL_CLIENT_CA_SECRET_NAME=otelcol-client-ca

OTEL_COLLECTOR_MEMORY_LIMIT=1g
OTEL_COLLECTOR_CPU_LIMIT=2.0
OTEL_COLLECTOR_GOMEMLIMIT=768MiB
