{
  "schemaVersion": "1.1",
  "component": "opentelemetry-collector",
  "role": "business-isolated-telemetry-ingress-normalization-redaction-sampling-and-routing-authority",
  "canonicalHostname": "otel.codestra.media",
  "exposure": "internal_private",
  "status": "CONFIG_PREPARED_NOT_DEPLOYED",
  "businessScope": [
    "platform",
    "codestra",
    "moneybee",
    "beyvra",
    "breero",
    "larim-a",
    "transportation",
    "booked4seasons",
    "social",
    "klyrow",
    "telnexa",
    "kyqra",
    "restaurant",
    "provisioning"
  ],
  "instanceModel": {
    "scope": "one_approved_codestra_business_per_collector_instance",
    "businessIdentitySource": "deployment_environment_not_caller_payload",
    "businessIngressNetwork": "isolated_per_business",
    "callerSuppliedBusinessAttributeTrusted": false,
    "crossBusinessIngestionDefault": "deny"
  },
  "protocols": {
    "ingress": ["otlp_grpc_mtls", "otlp_http_mtls"],
    "browserDirectIngestion": false,
    "publicNativePorts": false,
    "backendEgress": ["prometheus_pull", "tempo_otlp", "loki_otlp_http"]
  },
  "canonicalResourceAttributes": [
    "codestra.business",
    "codestra.application",
    "service.name",
    "service.version",
    "deployment.environment.name",
    "deployment.id",
    "cloud.region",
    "host.name"
  ],
  "canonicalMetricLabels": [
    "codestra_business",
    "application",
    "service",
    "service_version",
    "environment",
    "deployment",
    "region",
    "server",
    "tenant_scope"
  ],
  "requiredMetricFamilies": [
    "http_requests",
    "http_duration",
    "errors",
    "dependency_latency",
    "database_latency",
    "queue_depth",
    "worker_failures",
    "outbox_backlog",
    "inbox_backlog",
    "webhook_delivery",
    "webhook_retries",
    "authentication_failures",
    "authorization_denials",
    "idempotency_conflicts",
    "reconciliation_failures",
    "provider_health",
    "deployment_info",
    "capability_state"
  ],
  "forbiddenMetricLabelsOrResourceAttributes": [
    "tenant_id",
    "tenant_name",
    "organization_id",
    "organization_name",
    "customer_id",
    "customer_name",
    "account_id",
    "user_id",
    "user_name",
    "enduser.id",
    "user.email",
    "user.phone",
    "email",
    "phone",
    "session_id",
    "request_id",
    "correlation_id",
    "trace_id",
    "span_id",
    "message_id",
    "order_id",
    "workflow_id",
    "execution_id",
    "raw_url",
    "query_string",
    "db.statement",
    "exception.message",
    "service.instance.id",
    "host.id",
    "container.id",
    "k8s.pod.uid",
    "process.pid"
  ],
  "redaction": {
    "beforeExport": true,
    "requestAndResponseBodiesDefault": "forbidden",
    "logBodiesMustBeStructuredAndPreRedacted": true,
    "forbiddenContent": [
      "authorization_headers",
      "cookies",
      "passwords",
      "api_keys",
      "private_keys",
      "client_secrets",
      "access_or_refresh_tokens",
      "session_tokens",
      "database_dsns",
      "broker_or_exchange_credentials",
      "raw_customer_financial_payloads",
      "raw_email_sms_voice_payloads"
    ]
  },
  "sampling": {
    "authority": "opentelemetry-collector",
    "type": "tail_sampling",
    "preserve": [
      "error_status",
      "latency_at_or_above_2000ms",
      "security_priority",
      "reconciliation_priority",
      "capability_priority",
      "financial_priority",
      "delivery_priority"
    ],
    "routineSuccessPercentage": 10,
    "tempoPerformsAdditionalTailSampling": false
  },
  "durability": {
    "fileBackedExporterQueues": true,
    "retryOnFailure": true,
    "boundedQueueSize": true,
    "persistentVolumeRequired": true,
    "deliveryIsAtLeastOnceBestEffort": true,
    "businessSystemOfRecord": false
  },
  "features": {
    "otlpGrpc": true,
    "otlpHttp": true,
    "mutualTlsIngress": true,
    "businessIdentityOverwrite": true,
    "requiredWorkloadIdentity": true,
    "canonicalMetricNormalization": true,
    "metricCardinalityProtection": true,
    "resourceAndAttributeRedaction": true,
    "tailSampling": true,
    "durableExporterQueues": true,
    "memoryBackpressure": true,
    "batching": true,
    "prometheusExport": true,
    "tempoExport": true,
    "lokiExport": true,
    "businessTenantHeaders": true,
    "healthEndpoint": true,
    "selfMetrics": true,
    "jsonSelfLogs": true,
    "immutablePackaging": true,
    "privateNetworks": true
  },
  "authorityBoundaries": {
    "prometheusOwnsMetricsAndSLOs": true,
    "tempoOwnsTraceStorageAndQuery": true,
    "lokiOwnsLogStorageAndQuery": true,
    "grafanaOwnsPresentation": true,
    "alertmanagerOwnsAlertRouting": true,
    "businessMutation": false,
    "communicationsDelivery": false,
    "identityProvider": false,
    "secretsAuthority": false,
    "tradingMutation": false
  },
  "financialTradingBoundary": {
    "business": "beyvra",
    "rule": "The Collector may retain safe aggregate latency, provider health, reconciliation result, market-data freshness and capability state. It removes credentials, signing material, raw order payloads and customer financial identifiers and never receives trade placement, replacement, cancellation or approval authority."
  }
}
