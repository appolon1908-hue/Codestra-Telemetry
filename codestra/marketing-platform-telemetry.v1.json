{
  "schemaVersion": "1.0",
  "status": "CONTRACT_PREPARED_NOT_DEPLOYED",
  "domain": "codestra-marketing-platform",
  "services": ["kong","keycloak","middleware","marketing","ai","communication","social-control","social-runtime","n8n","odoo"],
  "signals": ["metrics","logs","traces"],
  "requirements": {
    "resourceIdentity": ["codestra.business","codestra.application","service.name","service.version","host.name","deployment.environment.name"],
    "mtlsRequired": true,
    "durableQueues": true,
    "tailSampling": true,
    "redactionRequired": true,
    "callerControlledBusinessIdentity": false
  },
  "forbiddenAttributes": ["access_token","refresh_token","client_secret","password","email","phone","name","address","message_body","prompt_body","response_body","raw_url","query_string"],
  "activation": {"runtimeApplied": false,"backendForwardingEnabled": false,"productionEnabled": false}
}
