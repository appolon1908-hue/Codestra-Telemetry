  "approvedFlows": [
    {
      "from": "alloy",
      "to": "loki",
      "signal": "logs",
      "ownership": "Alloy collects and redacts; Loki stores, retains, and serves business-isolated logs.",
      "mutating": false
    },
    {
      "from": "opentelemetry",
      "to": "loki",
      "signal": "logs",
      "ownership": "OpenTelemetry normalizes and routes application logs; Loki remains the log authority.",
      "mutating": false
    },
    {
      "from": "opentelemetry",
      "to": "prometheus",
      "signal": "metrics",
      "ownership": "OpenTelemetry exposes sanitized application metrics; Prometheus remains the metric, SLO, and alert authority.",
      "mutating": false
    },
    {
      "from": "opentelemetry",
      "to": "tempo",
      "signal": "traces",
      "ownership": "OpenTelemetry redacts and samples; Tempo stores and serves business-isolated traces.",
      "mutating": false
    },
    {
      "from": "node-exporter",
      "to": "prometheus",
      "signal": "metrics",
      "ownership": "Node Exporter emits bounded host and operational-evidence metrics for Prometheus scraping.",
      "mutating": false
    },
    {
      "from": "cadvisor",
      "to": "prometheus",
      "signal": "metrics",
      "ownership": "cAdvisor emits bounded container resource metrics for Prometheus scraping.",
      "mutating": false
    },
    {
      "from": "redis-exporter",
      "to": "prometheus",
      "signal": "metrics",
      "ownership": "Redis Exporter emits read-only aggregate Redis health metrics for Prometheus scraping.",
      "mutating": false
    },
    {
      "from": "blackbox-exporter",
      "to": "prometheus",
      "signal": "metrics",
      "ownership": "Blackbox Exporter emits bounded synthetic evidence for Prometheus evaluation.",
      "mutating": false
    },
    {
      "from": "prometheus",
      "to": "grafana",
      "signal": "metrics",
      "ownership": "Grafana reads corporate recording rules, SLOs, alerts, and aggregate metrics from Prometheus.",
      "mutating": false
    },
    {
      "from": "loki",
      "to": "grafana",
      "signal": "logs",
      "ownership": "Grafana reads business-isolated logs from fixed Loki datasources.",
      "mutating": false
    },
    {
      "from": "tempo",
      "to": "grafana",
      "signal": "traces",
      "ownership": "Grafana reads business-isolated traces from matching fixed Tempo datasources.",
      "mutating": false
    },
    {
      "from": "certified-readonly-datasets",
      "to": "superset",
      "signal": "analytics",
      "ownership": "Superset reads certified datasets through read-only credentials and enforced row-level security.",
      "mutating": false
    },
    {
      "from": "openbao",
      "to": "suite-workloads",
      "signal": "identity-certificates-secrets",
      "ownership": "OpenBao provides short-lived, policy-scoped identity, certificates, and runtime secrets without owning workload behavior.",
      "mutating": false
    }
  ],
